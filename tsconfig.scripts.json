{
  // Type-checking for the Node-only tooling: the QA gate, the generation
  // harness, the .pptx inspector, the fixture builder and the test suite.
  //
  // These are excluded from tsconfig.json because they import with explicit
  // '.ts' specifiers - Node's type-stripping resolver requires the extension,
  // while the Next build forbids it. Excluding them from the app build without
  // this file would mean they were never type-checked at all.
  //
  // Run: npx tsc -p tsconfig.scripts.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The whole reason this file exists. Everything else is inherited on
    // purpose: overriding `module`/`moduleResolution` to nodenext makes TS treat
    // the app's .ts files as CommonJS (the package has no "type": "module"),
    // which then rejects `import.meta` in code that Next compiles as ESM
    // perfectly happily. Those would be false positives, and a checker that
    // cries wolf gets switched off.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.mts", "scripts/**/*.ts", "tests/**/*.mts", "src/**/*.ts"],
  "exclude": ["node_modules", "scratch", ".next"]
}
