# Google Gemini API Key for DocuAI
# Copy this file to .env.local and insert your actual API key.
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# xAI Grok API Key (Optional failover/search provider)
GROK_API_KEY=

# Groq API Key (Optional Llama 3 generation provider)
GROQ_API_KEY=

# ==========================================
# KORAPAY PAYMENT API CONFIGURATION
# ==========================================

# Korapay Public Key (For client-side modal or popup integration)
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=your_korapay_public_key_here

# Korapay Secret Key (For backend API authorization & server-to-server requests)
KORAPAY_SECRET_KEY=your_korapay_secret_key_here

# Korapay Base API URL
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Webhook Secret / Signature Verification Key
KORAPAY_WEBHOOK_SECRET=your_korapay_webhook_secret_here

# Application Base URL (for payment redirection callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# DOCUMENT CONVERSION (DOCX -> PDF)
# ==========================================

# URL of a LibreOffice conversion service (Gotenberg is what the route speaks).
# When set, exporting an UNEDITED .docx upload converts the original file
# instead of re-rendering the editor's model of it. That is the only path that
# preserves page geometry, tables, embedded figures, list numbering,
# headers/footers and live hyperlinks exactly as the user formatted them.
#
# Leave blank to disable: the app falls back to the in-browser renderer, which
# still works but cannot reproduce what the import pipeline discarded.
#
# Run one locally with:
#   docker run --rm -p 3001:3000 gotenberg/gotenberg:8
#   DOCX_CONVERTER_URL=http://localhost:3001
#
# NOTE: `soffice` is a binary and cannot run inside a standard serverless
# function, so this must point at a container service (Fly, Render, Railway,
# Cloud Run) or a Vercel Sandbox — not at the Next.js deployment itself.
#
# Fonts: Times New Roman is not present on Linux. Either bake msttcorefonts
# into the converter image or accept metric-compatible Liberation Serif.
DOCX_CONVERTER_URL=

# ==========================================
# HUMANIZER (GHOSTWRITER REWRITE SERVICE)
# ==========================================

# Base URL of the GhostWriter rewrite API, which rewrites a document in the
# author's voice. Unlike DOCX_CONVERTER_URL this has a working default — the
# hosted service is public — so leave it blank unless you are pointing at your
# own instance.
#
# Default: https://ghostwriter-ai.pxxl.click
GHOSTWRITER_API_URL=

# Bearer token for the rewrite API. The published spec declares no security
# scheme, so this is only needed for a private instance behind a key.
GHOSTWRITER_API_KEY=

# ==========================================
# DOCUMENT INTEGRITY CHECKER
# ==========================================
#
# AI-writing detection and similarity scanning. Every one of these is read
# SERVER-SIDE ONLY — none is NEXT_PUBLIC_, and the browser never sees a
# provider credential. The client posts a document to /api/integrity/check and
# polls for a result; only the server talks to Copyleaks or GPTZero.
#
# The feature degrades rather than breaking: configure either provider, or
# both. With neither, the API answers 501 and the editor says integrity
# checking is not configured on this deployment.

# Copyleaks — AI detection AND similarity/plagiarism.
# Sign up at https://copyleaks.com/api. The key is a UUID from your dashboard,
# not your account password. The API exchanges these for a 48-hour access
# token, which the app caches: Copyleaks rate-limits login to 12 requests per
# 15 minutes and re-authenticating per scan would lock the account out.
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=

# GPTZero — independent AI detection, used as the second opinion.
# Key from https://gptzero.me/developers. Sent as the `x-api-key` header.
GPTZERO_API_KEY=

# Signs the similarity webhook URL.
#
# Copyleaks reports similarity results by calling us back, and publishes no
# signature scheme — the callback URL is the secret. This value is what makes
# that URL unguessable, so without it anyone who guessed a check id could post
# a fabricated similarity result into another user's report.
#
# Generate one with:  openssl rand -hex 32
#
# If unset, the app signs callbacks with a random per-process secret. That is
# fine locally but means any scan outstanding across a restart is abandoned.
INTEGRITY_WEBHOOK_SECRET=

# Lets the unauthenticated similarity webhook write results past row-level
# security. Only needed when Supabase is configured AND you have applied
# migrations/001_integrity_checks.sql.
#
# This key bypasses RLS entirely. It is imported by exactly one module
# (src/utils/supabaseAdmin.ts) and must never reach a client component.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE ON SIMILARITY AND LOCAL DEVELOPMENT
#
# Copyleaks delivers similarity results ONLY by webhook, so it needs a publicly
# reachable NEXT_PUBLIC_APP_URL. A localhost value is treated as no value at
# all — submitting it would have Copyleaks retry against an unreachable host
# and the user would wait fifteen minutes for a result that can never arrive.
#
# So on localhost, checks complete with AI detection only and the report says
# so. To exercise similarity locally, expose the app and point
# NEXT_PUBLIC_APP_URL at the public address:
#   cloudflared tunnel --url http://localhost:3000
#
# AI detection is synchronous and needs none of this — it works on localhost.

# ==========================================
# PLANS AND ENTITLEMENTS
# ==========================================
#
# Prices and quotas are NOT configured here. They live in src/utils/plans.ts,
# which the checkout, the pricing page, the paywall and the admin dashboard all
# import — a price in an env var would be a second copy for them to disagree
# with. The values below are informational only.
#
#   Free      ₦0       unlimited formatting; 1 integrity check/month; no AI writing
#   Base      ₦15,000  2 reports · 2 humanizes · 4 decks · 3 checks · 100 edits/day
#   Pro       ₦30,000  double the Base plan
#   Elite     ₦50,000  triple the Base plan
#
# Quotas are counted per PAYMENT, not per calendar month: each Korapay charge
# opens a new cycle with a full set of credits (see src/utils/entitlements/period.ts).
#
# Metering is stored in Supabase when configured, and in data/entitlements/ on
# disk otherwise. Apply migrations/002_entitlements.sql before deploying
# anywhere with a read-only filesystem.
NEXT_PUBLIC_PLAN_BASIC_AMOUNT=15000
NEXT_PUBLIC_PLAN_PRO_AMOUNT=30000
NEXT_PUBLIC_PLAN_ENTERPRISE_AMOUNT=50000

# ==========================================
# ADMIN DASHBOARD (/admin)
# ==========================================
#
# One operator credential pair, exchanged for an HMAC-signed session cookie.
# With either of the first two unset the dashboard refuses every login rather
# than falling back to a default — a built-in admin password is a backdoor
# however it is documented.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Accounts that own this deployment: every metered feature is unlimited for
# them, with no plan and no payment. Comma-separated; defaults to ADMIN_EMAIL.
#
# This only applies to a VERIFIED Supabase session. An offline "local" token
# carries its own email in its body and is self-asserted, so it is never
# accepted here — otherwise anyone could mint one bearing an owner address and
# take unlimited access. See utils/entitlements/service.ts:isOwnerRequest.
OWNER_EMAILS=

# Signs the admin session cookie. Generate one with:  openssl rand -hex 32
# If unset it is derived from ADMIN_PASSWORD, which works but means changing the
# password signs every admin session out.
ADMIN_SESSION_SECRET=

# NOTE: the dashboard also wants SUPABASE_SERVICE_ROLE_KEY (documented above,
# under the Integrity Checker). Without it, it can only see records this install
# wrote to disk and cannot create user accounts — it says so on screen rather
# than showing an empty list as though all were well.

