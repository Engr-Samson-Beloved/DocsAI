# Google Gemini API Key for DocuAI
# Copy this file to .env.local and insert your actual API key.
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# xAI Grok API Key (Optional failover/search provider)
GROK_API_KEY=

# Groq API Key (Optional Llama 3 generation provider)
GROQ_API_KEY=

# ==========================================
# KORAPAY PAYMENT API CONFIGURATION
# ==========================================

# Korapay Public Key (For client-side modal or popup integration)
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=your_korapay_public_key_here

# Korapay Secret Key (For backend API authorization & server-to-server requests)
KORAPAY_SECRET_KEY=your_korapay_secret_key_here

# Korapay Base API URL
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Webhook Secret / Signature Verification Key
KORAPAY_WEBHOOK_SECRET=your_korapay_webhook_secret_here

# Application Base URL (for payment redirection callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subscription Plan Amounts (NGN)
NEXT_PUBLIC_PLAN_BASIC_AMOUNT=5000
NEXT_PUBLIC_PLAN_PRO_AMOUNT=7000
NEXT_PUBLIC_PLAN_ENTERPRISE_AMOUNT=10000

